# Copy this file to `.env` and fill in your values:
#     cp .env.example .env          (macOS / Linux / Git Bash)
#     Copy-Item .env.example .env   (PowerShell)
# `.env` is git-ignored so your key never ends up on GitHub.

# --- LLM provider -----------------------------------------------------------
# "anthropic" = real LLM extraction with Claude (needs an API key)
# "offline"   = rule-based extractor, no key, no cost (good for learning the pipeline)
ACTIONGRAPH_LLM_PROVIDER=offline

# Get a key at https://platform.claude.com/ (Settings -> API keys)
ANTHROPIC_API_KEY=

# Model and reasoning effort (low | medium | high | xhigh | max)
ACTIONGRAPH_ANTHROPIC_MODEL=claude-opus-5-5
ACTIONGRAPH_ANTHROPIC_EFFORT=medium
ACTIONGRAPH_ANTHROPIC_MAX_TOKENS=16000
# If Claude declines a request, retry it server-side on Anthropic's recommended fallback model
ACTIONGRAPH_ANTHROPIC_ENABLE_FALLBACK=true

# --- Storage ----------------------------------------------------------------
ACTIONGRAPH_DATABASE_URL=sqlite:///data/actiongraph.db

# --- Human-in-the-loop --------------------------------------------------------
# Items whose confidence is below this value go to the review queue (0.0 - 1.0)
ACTIONGRAPH_REVIEW_THRESHOLD=0.7

# --- Speech-to-text (only used with `pip install -e ".[audio]"`) ------------
# tiny | base | small | medium | large-v3   (bigger = more accurate, slower)
ACTIONGRAPH_WHISPER_MODEL=base
ACTIONGRAPH_WHISPER_DEVICE=cpu

ACTIONGRAPH_LOG_LEVEL=INFO
